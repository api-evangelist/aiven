            "name": "List active queries",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.aiven.io/v1/project/:project/service/:service_name/clickhouse/query",
            "params": [
              {
                "name": "project",
                "value": "",
                "type": "path",
                "description": "Project name"
              },
              {
                "name": "service_name",
                "value": "",
                "type": "path",
                "description": "Service name"
              }
            ],
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "<p>Returns a list of active queries on a cluster.</p>"
        },
