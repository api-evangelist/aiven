            "name": "Trigger an access check on CMK",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.aiven.io/v1/project/:project/secrets/cmks/:cmk_id/access_check",
            "params": [
              {
                "name": "project",
                "value": "",
                "type": "path",
                "description": "Project name"
              },
              {
                "name": "cmk_id",
                "value": "",
                "type": "path",
                "description": "CMK ID"
              }
            ],
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Trigger an access check on CMK"
