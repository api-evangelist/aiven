            "name": "Get query optimization recommendations for a query",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.aiven.io/v1/account/:account_id/pg/query/optimize",
            "params": [
              {
                "name": "account_id",
                "value": "",
                "type": "path",
                "description": "Account ID"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            },
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "<p><blockquote>This endpoint <b>may be changed or removed at any time</b>. Don't use it in production environments.</blockquote><p>"
        },
